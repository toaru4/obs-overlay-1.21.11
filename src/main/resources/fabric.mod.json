{
  "schemaVersion": 1,
  "id": "obs_overlay",
  "version": "${version}",
  "name": "OBS Overlay",
  "description": "Experimental Minecraft 26.3 port. OpenGL native composition and Vulkan windowed readback presentation. Live OBS acceptance pending.",
  "authors": [
    "zziger",
    "toaru4"
  ],
  "license": "MIT",
  "environment": "client",
  "contact": {
    "sources": "https://github.com/toaru4/obs-overlay-1.21.11"
  },
  "entrypoints": {
    "client": [
      "me.zziger.obsoverlay.port.OBSOverlay"
    ],
    "modmenu": [
      "me.zziger.obsoverlay.port.ModMenuIntegration"
    ]
  },
  "mixins": [
    "obs_overlay.port.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
